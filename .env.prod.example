APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me

DB_NAME=commanderzone
DB_USER=commanderzone
DB_PASSWORD=change-me
DATABASE_URL=postgresql://commanderzone:change-me@database:5432/commanderzone?serverVersion=16&charset=utf8

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://api.commanderzone.com/.well-known/mercure
MERCURE_JWT_SECRET=change-me

SCRYFALL_USER_AGENT=CommanderZone/rc
SCRYFALL_SYNC_MEMORY_LIMIT=1024M
CORS_ALLOW_ORIGIN=^https://(app\.)?commanderzone\.com$
SYMFONY_TRUSTED_PROXIES=172.18.0.0/16
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port
USER_VISIT_HASH_SECRET=change-me-long-random-visit-hmac-secret
USER_VISIT_GEOIP_COUNTRY_DATABASE=/app/var/geoip/GeoLite2-Country.mmdb
USER_DAILY_VISIT_RETENTION_DAYS=180
AUTH_PUBLIC_APP_URL=https://app.commanderzone.com
MAILER_FROM_ADDRESS=no-reply@commanderzone.com
MAILER_FROM_NAME=CommanderZone
MAILER_DSN=null://null
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=.commanderzone.com
AUTH_REFRESH_REPLAY_GRACE_SECONDS=30
GOOGLE_OIDC_CLIENT_IDS=

GAME_WEBSOCKET_LISTEN=0.0.0.0:8081
GAME_WEBSOCKET_PUBLIC_URL=wss://api.commanderzone.com/ws
GAME_WEBSOCKET_CONNECTION_LIMIT=1000
GAME_WEBSOCKET_CONNECTION_LIMIT_PER_IP=100
GAME_DEBUG_HEALTH_ENABLED=0

GAME_RUNTIME_ENABLED=1
GAMEPLAY_COMPACT_RUNTIME_ENABLED=1
GAME_RUNTIME_LISTEN=0.0.0.0:8091
GAME_RUNTIME_PORT=8091
GAME_RUNTIME_INTERNAL_URL=http://game-runtime:8091
GAME_RUNTIME_WEBSOCKET_PUBLIC_URL=wss://api.commanderzone.com/runtime/ws
GAME_RUNTIME_TICKET_SECRET=change-me
GAME_RUNTIME_PERSISTENCE=postgres
GAME_RUNTIME_OWNERSHIP_MODE=single-node
GAME_RUNTIME_COMMAND_TIMEOUT=15s
GAME_RUNTIME_GO_BUILD_IMAGE=golang:1.22.12-bookworm
GO_TOOLCHAIN_IMAGE=commanderzone-go-toolchain:1.22

GAMEPLAY_V2_ENABLED=1
GAMEPLAY_V2_COMMAND_ENABLED=1
GAMEPLAY_V2_COMMANDS_ALLOWLIST=life.changed,turn.changed,dice.rolled,card.tapped,cards.tapped.set,card.face_down.changed,cards.face_down.set,card.revealed,hand.cards.reveal,hand.cards.revoke,card.controller.changed,cards.position.changed,card.counter.changed,counter.changed,commander.damage.changed,card.power_toughness.changed,card.stats.override.set,card.stats.override.clear,card.position.changed,library.draw,library.draw_many,library.reveal_top,library.reveal,library.play_top_revealed,library.reorder_top,library.move_top,library.put_top,library.put_bottom,library.view,library.selection.move,library.top.play_face_down,library.shuffle,card.token.created,token.group.split,token.group.merge,token.group.remove_members,token.group.dissolve,token.group.state.set,token.group.position.set,token.group.move,card.token_copy.created,zone.random_card.selected,card.dungeon_marker.changed,card.face.changed,card.moved,cards.moved,zone.reorderedByIds,zone.move_all,battlefield.untap_all,stack.card_added,stack.item_removed,arrow.created,arrow.removed,attachment.created,attachment.removed,helper.created,helper.updated,helper.removed,game.concede,game.close,mulligan.take,mulligan.keep,mulligan.cards_bottomed,mulligan.scry.confirm,mulligan.ready,mulligan.completed,game.phase.set,disconnect.vote
GAMEPLAY_V2_PATCH_ENABLED=1
GAMEPLAY_V2_BOOTSTRAP_ENABLED=1
GAMEPLAY_V2_EVENT_ENABLED=1
GAMEPLAY_V2_VISIBILITY_ENABLED=1
RUNTIME_SERVICE_ENABLED=1
SEMANTIC_PATCHES_ENABLED=1
COMPACT_BOOTSTRAP_ENABLED=1
GAMEPLAY_STREAMS_ENABLED=1
GAMEPLAY_METRICS_OUTPUT=
SHADOW_COMPARE_ENABLED=0
